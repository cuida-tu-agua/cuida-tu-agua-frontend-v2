# Copiar este archivo a ".env" (en la raíz de FrontEnd/CuidaTuAgua) y ajustar
# la URL según el entorno. Expo expone automáticamente cualquier variable con
# el prefijo EXPO_PUBLIC_ vía process.env, sin dependencias adicionales.
#
# Debe incluir el prefijo /api porque así está montado el backend
# (ver Program.cs / HogaresController -> api/[controller]).
EXPO_PUBLIC_API_URL=http://localhost:5000/api
